#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec4 position;
    vec4 velocity;
    vec4 color;
};

// Both read and write views alias the same bindless SSBO array at set 0,
// binding 1. Different push-constant indices pick the "previous" and
// "current" particle frame buffers.
layout(std140, set = 0, binding = 1) readonly buffer ParticleSSBOIn {
    Particle data[];
} particlesIn[];

layout(std140, set = 0, binding = 1) buffer ParticleSSBOOut {
    Particle data[];
} particlesOut[];

layout(set = 1, binding = 0) uniform UBODeltaTime {
    float deltaTime;
} u;

// PC layout mirrors the engine-shared {uint, uint} struct — here the two
// slots carry the previous- and current-frame bindless buffer indices.
layout(push_constant) uniform PC {
    uint prevIdx;
    uint currIdx;
} pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    Particle pIn = particlesIn[nonuniformEXT(pc.prevIdx)].data[index];

    particlesOut[nonuniformEXT(pc.currIdx)].data[index].position =
        pIn.position + pIn.velocity * u.deltaTime * 0.009;
    particlesOut[nonuniformEXT(pc.currIdx)].data[index].velocity = pIn.velocity;
    particlesOut[nonuniformEXT(pc.currIdx)].data[index].color    = pIn.color;
}
